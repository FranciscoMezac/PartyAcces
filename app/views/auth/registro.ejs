<%- include('../partials/head') %>
<section class="container py-4">
  <h1 class="mb-3"><%= title %></h1>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/registro" method="post" class="row g-3" autocomplete="off">
    <div class="col-12">
      <label class="form-label" for="nombre">Nombre</label>
      <input class="form-control" id="nombre" name="nombre" required value="<%= values.nombre || '' %>">
    </div>
    <div class="col-12">
      <label class="form-label" for="email">Email</label>
      <input class="form-control" id="email" name="email" type="email" required value="<%= values.email || '' %>">
    </div>
    <div class="col-12">
      <label class="form-label" for="password">Contraseña</label>
      <input class="form-control" id="contrasenia" name="contrasenia" type="password" required>
    </div>
    <div class="col-12">
      <label class="form-label" for="rol">Rol</label>
      <input class="form-control" id="rol" name="rol" required value="<%= values.rol || '' %>">
    </div>
    <div class="col-12">
      <label class="form-label" for="estado">Estado</label>
      <input class="form-control" id="estado" name="estado" required value="<%= values.estado || '' %>">
    </div>
    <div class="col-12">
      <button class="btn btn-primary" type="submit">Registrarme</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>